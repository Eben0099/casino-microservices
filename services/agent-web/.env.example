# =============================================================================
# agent-web (POS) environment
# =============================================================================
# Two integration modes coexist permanently:
#
#  standalone : POS talks to the original Python ticket-service +
#               agent-service. Default. Zero-regression target.
#
#  agd        : POS talks to agd-casino-service through the AGD Traefik
#               gateway. Used when embedded in agd_terminal_web_app or
#               when the POS is deployed inside the AGD platform.
# =============================================================================

VITE_INTEGRATION_MODE=standalone

# --- standalone backends (defaults below match docker-compose.yml) ---------
VITE_STANDALONE_API_URL=/api

# --- AGD backends (used only when VITE_INTEGRATION_MODE=agd) ---------------
VITE_AGD_API_URL=http://localhost:8880/api/v1/agd_casino
VITE_AGD_AUTH_URL=http://localhost:8880/api/v1/agd_auth
VITE_AGD_WS_URL=http://localhost:8880/casino/ws

# Casino game code to open a session against (must exist in agd-casino-service
# catalog, default seed = ROULETTE_EU)
VITE_AGD_GAME_CODE=ROULETTE_EU
